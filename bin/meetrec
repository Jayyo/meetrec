#!/usr/bin/env python3
"""Launcher for the meetrec window."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for root in (os.path.join(here, "..", "share", "meetrec"), os.path.join(here, "..")):
    if os.path.isdir(os.path.join(root, "meetrec")):
        sys.path.insert(0, os.path.abspath(root))
        break

from meetrec.app import main  # noqa: E402

sys.exit(main())
